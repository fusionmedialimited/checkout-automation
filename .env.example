# Example environment variables for local runs.
#
# This file is NOT loaded automatically — nothing in this project reads .env files. Export
# these yourself (e.g. `set -a && source .env && set +a`) or set them in your CI job. Config.java
# reads env vars as: uppercase the property key and replace '.' with '_' (qa.baseUrl ->
# QA_BASEURL). JVM properties (-Dqa.baseUrl=...) always win over these; see docs/architecture.md.
#
# Never commit a real .env file — it is gitignored.

# Application environment
QA_BASEURL=https://master--www.ams-qa.finboxgcp.investing.com/pro/

# Payment mode is independent of the application URL and has no safe default — set it
# explicitly, and only after verifying the processor is actually in the mode you claim.
# QA_PAYMENTMODE=sandbox

# Execution gates — all default to false/disabled. See docs/payment-safety.md before enabling.
QA_ALLOWUSERCREATION=false
QA_ALLOWSANDBOXPURCHASE=false
QA_ALLOWREALCARDPURCHASE=false
# QA_REALCARDAUTHORIZATIONREF=TICKET-1234

# Browser / execution
QA_BROWSER=chromium
QA_HEADLESS=true
QA_TIMEOUTMS=30000
QA_ARTIFACTPOLICY=on-failure
